# ==============================================================================
# MANAKSETU: Environment Configuration Template
# Copy this file to .env for local overrides if needed.
# Defaults are pre-configured to work out-of-the-box without extra setup.
# ==============================================================================

# Backend Database Connection
# Default uses local SQLite database in backend/data/manaksetu.db
DATABASE_URL=sqlite:///./backend/data/manaksetu.db

# Backend Server Port (Default: 8000)
PORT=8000

# Requirement Analyzer LLM Provider (Default: "none" - uses deterministic extraction)
# Options: "none" (recommended for zero-latency, deterministic, offline operation)
LLM_PROVIDER=none

# Frontend API Base URL (Used by Vite during development/production)
# In local development, the Vite dev server proxies requests from /api to http://127.0.0.1:8000
# In production builds, default points to https://manaksetu-api.onrender.com/api
# Uncomment to override:
# VITE_API_URL=http://127.0.0.1:8000/api
